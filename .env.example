APP_PORT=3017
MYSQL_PORT=3317
MYSQL_DATABASE=subscription_db
MYSQL_USER=subscription_user
MYSQL_PASSWORD=subscription_pass
MYSQL_ROOT_PASSWORD=subscription_root

# Host tools (Prisma CLI, npm run dev) use the published MySQL port.
DATABASE_URL=mysql://subscription_user:subscription_pass@127.0.0.1:3317/subscription_db
# Inside Docker Compose the app uses hostname mysql on the internal port. The compose file sets this.
# DATABASE_URL=mysql://subscription_user:subscription_pass@mysql:3306/subscription_db

NEXT_PUBLIC_APP_URL=http://localhost:3017
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3017
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3017

PAYMENT_PROVIDER=manual
PAYMENT_SECRET=replace-with-a-webhook-secret
EMAIL_PROVIDER=console
EMAIL_API_KEY=
SMS_PROVIDER=console
SMS_API_KEY=
